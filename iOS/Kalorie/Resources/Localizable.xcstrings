    "account_ciqualAttribution" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutriční hodnoty obecných potravin pocházejí z tabulek ANSES Ciqual 2020 (licence CC BY 4.0). Hodnoty jsme upravili: přepočítali jsme je na 100 ml, dopočítali chybějící kalorie a doplnili porce."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrition values of generic foods come from the ANSES Ciqual 2020 tables (CC BY 4.0). We modified them: converted to 100 ml, derived missing calories and added portions."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutričné hodnoty všeobecných potravín pochádzajú z tabuliek ANSES Ciqual 2020 (licencia CC BY 4.0). Hodnoty sme upravili: prepočítali sme ich na 100 ml, dopočítali chýbajúce kalórie a doplnili porcie."
          }
        }
      }
    },
