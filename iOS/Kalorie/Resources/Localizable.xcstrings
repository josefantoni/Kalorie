    "account_alert_deleteConfirmMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto akci nelze vzít zpět. Všechna tvá data budou trvale smazána."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This action can't be undone. All your data will be permanently deleted."
          }
