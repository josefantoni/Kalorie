    "account_linkInfo_apple" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jsi přihlášen/a přes Apple ID. Pokud chceš, můžeš se propojit i s Google a přihlašovat se oběma způsoby."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are signed in with Apple ID. If you like, you can also link Google and sign in either way."
          }
