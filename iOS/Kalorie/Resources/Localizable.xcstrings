        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si prihlásený/á cez Apple ID. Ak chceš, môžeš sa prepojiť aj s Googlom a prihlasovať sa oboma spôsobmi."
          }
        }
      }
    },
    "account_linkInfo_both" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj účet je propojený s Apple ID i s Google. Přihlašovat se můžeš (klidně na jiném zařízení) kteroukoli z těchto metod, jak se ti zrovna hodí."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account is linked with both Apple ID and Google. You can sign in (even on another device) with whichever method you like."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj účet je prepojený s Apple ID aj s Googlom. Prihlasovať sa môžeš (pokojne aj na inom zariadení) ktoroukoľvek z týchto metód, ako sa ti práve hodí."
