    "account_error_linkCredentialBelongsToAnotherAccount" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto přihlášení už má vlastní účet v Kalorie. Chceš-li ho propojit sem, přihlas se jím, smaž ten účet, přihlas se zpět a propoj ho. Nic se nezměnilo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sign-in already has its own Kalorie account. To link it here, sign in with it, delete that account, sign back in, and link it. Nothing has changed."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto prihlásenie už má vlastný účet v Kalorie. Ak ho chceš prepojiť sem, prihlás sa ním, zmaž ten účet, prihlás sa späť a prepoj ho. Nič sa nezmenilo."
          }
        }
      }
    },
