    "addFood_submission_submittedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadané údaje jsme odeslali správci ke schválení. Do té doby položka nebude v katalogu potravin viditelná. Stav najdeš v sekci „Moje návrhy“, až příště otevřeš přidání potraviny."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We've sent what you entered to the maintainer for approval. Until then, the item won't be visible in the food catalogue. You'll find its status under \"My submissions\" the next time you open Add food."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadané údaje sme odoslali správcovi na schválenie. Dovtedy nebude položka v katalógu potravín viditeľná. Stav nájdeš v sekcii „Moje návrhy“, keď nabudúce otvoríš pridanie potraviny."
          }
        }
      }
    },
