rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMaintainer() {
      return request.auth != null && request.auth.token.maintainer == true;
    }
    function validJpeg() {
      return request.resource.size < 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
    }

    match /submissionPhotos/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isMaintainer());
      allow create: if request.auth != null && request.auth.uid == uid && validJpeg();
      allow delete: if request.auth != null && (request.auth.uid == uid || isMaintainer());
    }

    function suggestionItemId(fileName) {
      return fileName.split('\\.jpg')[0];
    }
    function suggestionItemPath(fileName) {
      return /databases/(default)/documents/foodItems/$(suggestionItemId(fileName));
    }
    function validSuggestionFileName(fileName) {
      return fileName.matches('([0-9]{8}|[0-9]{12}|[0-9]{13}|[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12})\\.jpg');
    }

    match /photoSuggestions/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isMaintainer());
      allow create: if request.auth != null && request.auth.uid == uid && resource == null && validJpeg() &&
        validSuggestionFileName(fileName) &&
        firestore.exists(suggestionItemPath(fileName)) &&
        !('photo_url' in firestore.get(suggestionItemPath(fileName)).data) &&
        !firestore.exists(/databases/(default)/documents/photoSuggestions/$(suggestionItemId(fileName) + '_' + uid));
      allow delete: if request.auth != null && (request.auth.uid == uid || isMaintainer());
    }

    match /catalogPhotos/{itemId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if isMaintainer() && validJpeg();
      allow delete: if isMaintainer();
    }
  }
}
