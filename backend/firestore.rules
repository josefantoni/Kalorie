rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMaintainer() {
      return request.auth != null && request.auth.token.maintainer == true;
    }

    function validItemId(id) {
      return id.matches('[0-9]{8}|[0-9]{12}|[0-9]{13}') ||
        id.matches('[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}');
    }

    function photoUrlPrefix() {
      return 'https://firebasestorage\\.googleapis\\.com/v0/b/kalorie-bf11c\\.firebasestorage\\.app/o/';
    }

    function validFoodItem(data) {
      return data.id is string &&
        validItemId(data.id) &&
        data.cz_name is string &&
        data.eng_name is string &&
        data.cz_name_lowercase is string &&
        data.eng_name_lowercase is string &&
        data.cz_name_folded is string &&
        data.eng_name_folded is string &&
        data.cz_name_search_terms is list &&
        data.eng_name_search_terms is list &&
        data.weight is number &&
        data.date is number &&
        data.calories_per_hundred_grams is number &&
        data.fat is number &&
        data.fat_unsaturated_fatty_acids is number &&
        data.carbohydrate is number &&
        data.carbohydrate_pure_sugar is number &&
        data.protein is number &&
        data.salt is number &&
        (!('energy_kj' in data) || data.energy_kj is number) &&
        (!('fat_saturated' in data) || data.fat_saturated is number) &&
        (!('fiber' in data) || data.fiber is number) &&
        (!('measure_unit' in data) || data.measure_unit in ['grams', 'millilitres']) &&
        (!('alcohol_by_volume' in data) ||
          (data.alcohol_by_volume is number && data.alcohol_by_volume > 0 && data.alcohol_by_volume <= 100)) &&
        (!('photo_url' in data) || (data.photo_url is string && data.photo_url.size() <= 1024));
    }

    function ownSubmissionPhoto(item) {
      return 'photo_url' in item &&
        item.photo_url.matches(photoUrlPrefix() + 'submissionPhotos%2F' + request.auth.uid + '%2F.*');
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /foodItems/{itemId} {
      allow read: if request.auth != null;
      allow create, update: if isMaintainer() &&
        validItemId(itemId) &&
        request.resource.data.id == itemId &&
        validFoodItem(request.resource.data) &&
        (!('photo_url' in request.resource.data) ||
          request.resource.data.photo_url.matches(photoUrlPrefix() + 'catalogPhotos%2F.*'));
    }

    match /foodItemSubmissions/{submissionId} {
      allow read: if isMaintainer() || resource.data.submitted_by == request.auth.uid;

      allow create: if request.auth != null &&
        request.resource.data.id == submissionId &&
        request.resource.data.submitted_by == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        validFoodItem(request.resource.data.item) &&
        ownSubmissionPhoto(request.resource.data.item);

      allow update: if (isMaintainer() &&
          request.resource.data.submitted_by == resource.data.submitted_by &&
          request.resource.data.get('barcode', null) == resource.data.get('barcode', null) &&
          request.resource.data.submitted_at == resource.data.submitted_at &&
          request.resource.data.status == 'rejected' &&
          request.resource.data.reject_reason is string &&
          request.resource.data.reject_reason.size() > 0 &&
          validFoodItem(request.resource.data.item)) ||
        (resource.data.submitted_by == request.auth.uid &&
          request.resource.data.submitted_by == resource.data.submitted_by &&
          request.resource.data.get('barcode', null) == resource.data.get('barcode', null) &&
          request.resource.data.status == 'pending' &&
          validFoodItem(request.resource.data.item) &&
          ownSubmissionPhoto(request.resource.data.item));

      allow delete: if isMaintainer() || resource.data.submitted_by == request.auth.uid;
    }

    match /foodItemReports/{reportId} {
      allow read: if isMaintainer() ||
        (resource.data.get('reported_by', null) == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['barcode', 'reported_by', 'reported_at', 'reason', 'status', 'locale', 'hidden']) &&
        request.resource.data.reported_by == request.auth.uid &&
        validItemId(request.resource.data.barcode) &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.reported_at is number &&
        request.resource.data.status == 'pending' &&
        request.resource.data.hidden == false &&
        request.resource.data.locale in ['cs', 'en', 'sk'];

      allow update: if request.auth != null &&
        resource.data.get('reported_by', null) == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen_at', 'hidden']) &&
        request.resource.data.get('seen_at', 0) is number &&
        (request.resource.data.hidden == true || request.resource.data.hidden == resource.data.hidden);

      allow update: if request.auth != null &&
        resource.data.get('reported_by', null) == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reported_by', 'author_deleted']) &&
        !('reported_by' in request.resource.data) &&
        request.resource.data.author_deleted == true;

      allow update: if isMaintainer() &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response', 'resolved_at', 'hidden']) &&
        request.resource.data.status in ['accepted', 'rejected'] &&
        request.resource.data.hidden == false &&
        request.resource.data.response is string &&
        request.resource.data.response.size() > 0 &&
        request.resource.data.response.size() <= 1000 &&
        request.resource.data.resolved_at is number;

      allow delete: if isMaintainer() ||
        (resource.data.get('reported_by', null) == request.auth.uid && resource.data.status == 'pending');
    }

    match /photoSuggestions/{suggestionId} {
      allow read: if isMaintainer() ||
        (resource.data.get('suggested_by', null) == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['item_id', 'suggested_by', 'suggested_at', 'photo_url', 'status', 'locale', 'hidden']) &&
        request.resource.data.suggested_by == request.auth.uid &&
        validItemId(request.resource.data.item_id) &&
        request.resource.data.photo_url is string &&
        request.resource.data.photo_url.size() <= 1024 &&
        request.resource.data.photo_url.matches(
          photoUrlPrefix() + 'photoSuggestions%2F' + request.auth.uid + '%2F' +
          request.resource.data.item_id + '%2F' + suggestionId + '\\.jpg.*') &&
        exists(/databases/$(database)/documents/foodItems/$(request.resource.data.item_id)) &&
        !('photo_url' in get(/databases/$(database)/documents/foodItems/$(request.resource.data.item_id)).data) &&
        request.resource.data.suggested_at is number &&
        request.resource.data.status == 'pending' &&
        request.resource.data.hidden == false &&
        request.resource.data.locale in ['cs', 'en', 'sk'];

      allow update: if request.auth != null &&
        resource.data.get('suggested_by', null) == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen_at', 'hidden']) &&
        request.resource.data.get('seen_at', 0) is number &&
        (request.resource.data.hidden == true || request.resource.data.hidden == resource.data.hidden);

      allow update: if request.auth != null &&
        resource.data.get('suggested_by', null) == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suggested_by', 'author_deleted']) &&
        !('suggested_by' in request.resource.data) &&
        request.resource.data.author_deleted == true;

      allow update: if isMaintainer() &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response', 'resolved_at', 'hidden']) &&
        request.resource.data.status in ['accepted', 'rejected'] &&
        request.resource.data.hidden == false &&
        request.resource.data.response is string &&
        request.resource.data.response.size() > 0 &&
        request.resource.data.response.size() <= 1000 &&
        request.resource.data.resolved_at is number;

      allow delete: if isMaintainer() ||
        (resource.data.get('suggested_by', null) == request.auth.uid && resource.data.status == 'pending');
    }
  }
}
